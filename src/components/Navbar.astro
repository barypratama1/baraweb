---
<header class="fixed top-0 w-full z-50 bg-slate-900/80 backdrop-blur-lg border-b border-white/5 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      
      <!-- Logo -->
      <a href="#home" class="flex-shrink-0 flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-violet-600 to-cyan-500 flex items-center justify-center font-bold text-xl shadow-[0_0_15px_rgba(139,92,246,0.5)] group-hover:shadow-[0_0_25px_rgba(6,182,212,0.6)] transition-all duration-300">
          BDK
        </div>
        <span class="font-bold text-2xl tracking-tight text-white">BaraDigital<span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-cyan-400">Kreasi</span></span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex space-x-8">
        <a href="/#home" class="text-slate-300 hover:text-cyan-400 transition-colors text-sm font-medium uppercase tracking-wider">Home</a>
        <a href="/#about" class="text-slate-300 hover:text-cyan-400 transition-colors text-sm font-medium uppercase tracking-wider">Tentang Kami</a>
        <a href="/#services" class="text-slate-300 hover:text-cyan-400 transition-colors text-sm font-medium uppercase tracking-wider">Layanan</a>
        <a href="/blog" class="text-slate-300 hover:text-cyan-400 transition-colors text-sm font-medium uppercase tracking-wider">Blog</a>
        <a href="/#contact" class="text-slate-300 hover:text-cyan-400 transition-colors text-sm font-medium uppercase tracking-wider">Kontak</a>
      </nav>

      <!-- CTA Button -->
      <div class="hidden md:flex items-center">
        <a href="#contact" class="px-6 py-2.5 rounded-full bg-white/10 hover:bg-white/20 border border-white/10 text-sm font-medium transition-all duration-300 hover:shadow-[0_0_15px_rgba(255,255,255,0.1)]">
          Mulai Proyek
        </a>
      </div>

    </div>
  </div>
</header>
