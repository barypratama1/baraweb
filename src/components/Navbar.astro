---

---

<header
  class="fixed top-0 w-full z-50 bg-white/95 backdrop-blur-lg border-b border-slate-100 shadow-sm transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <!-- Logo -->
      <a href="/#home" class="flex-shrink-0 flex items-center gap-3 group">
        <img
          src="/logo-icon.png"
          alt="Logo Bara Digital Kreasi"
          class="w-11 h-11 object-contain group-hover:scale-105 transition-transform duration-300"
        />
        <div class="flex flex-col leading-none">
          <span class="font-extrabold text-2xl tracking-wider text-[#1a4689]"
            >BARA</span
          >
          <span
            class="font-bold text-[10px] tracking-[0.22em] text-[#f68c2c] mt-0.5"
            >DIGITAL KREASI</span
          >
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex space-x-8">
        <a
          href="/#home"
          class="text-slate-600 hover:text-[#1a4689] transition-colors text-sm font-medium uppercase tracking-wider"
          >Home</a
        >
        <a
          href="/#about"
          class="text-slate-600 hover:text-[#1a4689] transition-colors text-sm font-medium uppercase tracking-wider"
          >Tentang Kami</a
        >
        <a
          href="/#services"
          class="text-slate-600 hover:text-[#1a4689] transition-colors text-sm font-medium uppercase tracking-wider"
          >Layanan</a
        >
        <a
          href="/modelhub"
          class="text-slate-600 hover:text-[#1a4689] transition-colors text-sm font-medium uppercase tracking-wider"
          >ModelHub</a
        >
        <a
          href="/blog"
          class="text-slate-600 hover:text-[#1a4689] transition-colors text-sm font-medium uppercase tracking-wider"
          >Blog</a
        >
        <a
          href="/#contact"
          class="text-slate-600 hover:text-[#1a4689] transition-colors text-sm font-medium uppercase tracking-wider"
          >Kontak</a
        >
      </nav>

      <!-- CTA Button -->
      <div class="hidden md:flex items-center">
        <a
          href="/#contact"
          class="px-6 py-2.5 rounded-full bg-gradient-to-r from-[#1a4689] via-[#d64a35] to-[#f68c2c] hover:opacity-95 text-white text-sm font-semibold transition-all duration-300 shadow-md shadow-[#1a4689]/15 hover:shadow-lg hover:shadow-[#f68c2c]/25"
        >
          Mulai Proyek
        </a>
      </div>
    </div>
  </div>
</header>
