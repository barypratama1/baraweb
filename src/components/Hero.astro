---

---

<section
  id="home"
  class="relative min-h-screen flex items-center justify-center pt-20 overflow-hidden bg-white"
>
  <!-- Subtle background decoration -->
  <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
    <div
      class="absolute -top-40 -right-40 w-[600px] h-[600px] bg-[#f68c2c]/10 rounded-full blur-[90px]"
    >
    </div>
    <div
      class="absolute -bottom-40 -left-40 w-[500px] h-[500px] bg-[#1a4689]/10 rounded-full blur-[90px]"
    >
    </div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div
      class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-slate-200 shadow-xs mb-8"
    >
      <span class="w-2 h-2 rounded-full bg-[#f68c2c] animate-pulse"></span>
      <span class="text-sm font-medium text-[#1a4689]"
        >Inovasi Digital Generasi Berikutnya</span
      >
    </div>

    <h1
      class="text-5xl md:text-7xl font-extrabold tracking-tight mb-8 text-slate-900 leading-tight"
    >
      Membangun Masa Depan <br class="hidden md:block" />
      <span
        class="text-transparent bg-clip-text bg-gradient-to-r from-[#1a4689] via-[#d64a35] to-[#f68c2c]"
        >Tanpa Batas</span
      >
    </h1>

    <p class="max-w-2xl mx-auto text-lg md:text-xl text-slate-500 mb-12">
      Kami adalah Bara Digital Kreasi. Mitra teknologi andal untuk mempercepat
      transformasi digital bisnis Anda dengan solusi inovatif, aman, dan
      terukur.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/#services"
        class="w-full sm:w-auto px-8 py-4 rounded-full bg-[#1a4689] hover:bg-[#133568] text-white font-semibold shadow-lg shadow-[#1a4689]/20 hover:shadow-[#1a4689]/30 transition-all duration-300 transform hover:-translate-y-1"
      >
        Eksplorasi Layanan
      </a>
      <a
        href="/#contact"
        class="w-full sm:w-auto px-8 py-4 rounded-full border-2 border-slate-200 hover:border-[#f68c2c] text-slate-700 hover:text-[#1a4689] font-semibold transition-all duration-300 bg-white hover:bg-[#f68c2c]/5"
      >
        Konsultasi Gratis
      </a>
    </div>
  </div>
</section>
