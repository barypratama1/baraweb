---

---

<section
  id="home"
  class="relative min-h-screen flex items-center justify-center pt-20 overflow-hidden bg-white"
>
  <!-- Subtle background decoration -->
  <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
    <div
      class="absolute -top-40 -right-40 w-[600px] h-[600px] bg-indigo-100 rounded-full opacity-60 blur-[80px]"
    >
    </div>
    <div
      class="absolute -bottom-40 -left-40 w-[500px] h-[500px] bg-violet-100 rounded-full opacity-60 blur-[80px]"
    >
    </div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div
      class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-indigo-50 border border-indigo-100 mb-8"
    >
      <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
      <span class="text-sm font-medium text-indigo-700"
        >Inovasi Digital Generasi Berikutnya</span
      >
    </div>

    <h1
      class="text-5xl md:text-7xl font-extrabold tracking-tight mb-8 text-slate-900 leading-tight"
    >
      Membangun Masa Depan <br class="hidden md:block" />
      <span
        class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 via-violet-500 to-purple-600"
        >Tanpa Batas</span
      >
    </h1>

    <p class="max-w-2xl mx-auto text-lg md:text-xl text-slate-500 mb-12">
      Kami adalah Bara Digital Kreasi. Mitra teknologi andal untuk mempercepat
      transformasi digital bisnis Anda dengan solusi inovatif, aman, dan
      terukur.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/#services"
        class="w-full sm:w-auto px-8 py-4 rounded-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold shadow-lg shadow-indigo-200 hover:shadow-indigo-300 transition-all duration-300 transform hover:-translate-y-1"
      >
        Eksplorasi Layanan
      </a>
      <a
        href="/#contact"
        class="w-full sm:w-auto px-8 py-4 rounded-full border-2 border-slate-200 hover:border-indigo-300 text-slate-700 hover:text-indigo-600 font-semibold transition-all duration-300 bg-white hover:bg-indigo-50"
      >
        Konsultasi Gratis
      </a>
    </div>
  </div>
</section>
