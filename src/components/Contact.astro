<section
  id="contact"
  class="py-24 relative bg-slate-50 border-t border-slate-100"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div
      class="bg-white border border-slate-100 rounded-3xl p-8 md:p-12 lg:p-16 relative overflow-hidden shadow-sm"
    >
      <div
        class="absolute top-0 right-0 w-80 h-80 bg-indigo-50 rounded-full blur-[80px] pointer-events-none"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 w-60 h-60 bg-violet-50 rounded-full blur-[60px] pointer-events-none"
      >
      </div>

      <div
        class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10"
      >
        <div>
          <h2 class="text-3xl md:text-4xl font-bold mb-4 text-slate-900">
            Siap untuk <span
              class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-violet-500"
              >Bertransformasi?</span
            >
          </h2>
          <p class="text-slate-500 mb-8 text-lg">
            Hubungi kami untuk mendiskusikan bagaimana teknologi dapat
            mempercepat pertumbuhan bisnis Anda hari ini.
          </p>

