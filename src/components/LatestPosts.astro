---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestPosts = sortedPosts.slice(0, 3);
---
<section id="blog" class="py-24 relative bg-white border-t border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-end mb-12">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold mb-4 text-slate-900">Artikel <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#1a4689] via-[#d64a35] to-[#f68c2c]">Terbaru</span></h2>
        <p class="text-slate-500 max-w-2xl text-lg">Wawasan dan pemikiran terkini dari tim ahli kami seputar teknologi dan industri.</p>
      </div>
      <a href="/blog" class="hidden md:inline-flex items-center gap-2 text-[#1a4689] hover:text-[#f68c2c] font-medium transition-colors">
        Lihat Semua
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>

    <div class="flex flex-col gap-4">
      {latestPosts.map((post) => (
        <a href={`/blog/${post.id}`} class="group block bg-white hover:bg-[#1a4689]/[0.02] border border-slate-100 hover:border-[#1a4689]/25 rounded-2xl p-6 transition-all duration-300 shadow-sm hover:shadow-md">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
              <p class="text-[#f68c2c] text-sm font-medium mb-2">
                {post.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}
              </p>
              <h3 class="text-xl font-bold text-slate-900 group-hover:text-[#1a4689] transition-colors mb-2">{post.data.title}</h3>
              <p class="text-slate-500 text-sm">{post.data.description}</p>
            </div>
            <div class="hidden md:flex flex-shrink-0 w-10 h-10 rounded-full bg-slate-50 border border-slate-100 items-center justify-center text-slate-400 group-hover:bg-[#1a4689] group-hover:border-[#1a4689] group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-8 md:hidden">
      <a href="/blog" class="inline-flex items-center justify-center w-full py-3 rounded-xl bg-[#1a4689]/5 text-[#1a4689] font-medium border border-[#1a4689]/15">
        Lihat Semua Artikel
      </a>
    </div>
  </div>
</section>
