---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestPosts = sortedPosts.slice(0, 3);
---
<section id="blog" class="py-24 relative bg-slate-900 border-t border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-end mb-12">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Artikel <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-cyan-400">Terbaru</span></h2>
        <p class="text-slate-400 max-w-2xl text-lg">Wawasan dan pemikiran terkini dari tim ahli kami seputar teknologi dan industri.</p>
      </div>
      <a href="/blog" class="hidden md:inline-flex items-center gap-2 text-cyan-400 hover:text-cyan-300 font-medium transition-colors">
        Lihat Semua
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>

    <div class="flex flex-col gap-4">
      {latestPosts.map((post) => (
        <a href={`/blog/${post.id}`} class="group block bg-slate-800/30 hover:bg-slate-800/80 border border-white/5 hover:border-violet-500/30 rounded-2xl p-6 transition-all duration-300">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
              <p class="text-cyan-400 text-sm font-medium mb-2">
                {post.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}
              </p>
              <h3 class="text-xl font-bold text-white group-hover:text-violet-400 transition-colors mb-2">{post.data.title}</h3>
              <p class="text-slate-400 text-sm">{post.data.description}</p>
            </div>
            <div class="hidden md:flex flex-shrink-0 w-10 h-10 rounded-full bg-white/5 items-center justify-center text-slate-400 group-hover:bg-violet-500/20 group-hover:text-violet-400 transition-colors">
               <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </div>
        </a>
      ))}
    </div>
    
    <div class="mt-8 md:hidden">
      <a href="/blog" class="inline-flex items-center justify-center w-full py-3 rounded-lg bg-white/5 text-cyan-400 font-medium border border-white/10">
        Lihat Semua Artikel
      </a>
    </div>
  </div>
</section>
