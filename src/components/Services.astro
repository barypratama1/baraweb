---
const services = [
  {
    title: "Pengembangan Web & Aplikasi",
    desc: "Aplikasi kustom, skalabel, dan aman yang dirancang untuk performa tinggi dengan teknologi terkini.",
    icon: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
    color: "text-indigo-600",
    bg: "bg-indigo-50",
    border: "border-indigo-100",
  },
  {
    title: "IT Consulting",
    desc: "Memberikan panduan strategis dan solusi teknologi yang tepat untuk mengoptimalkan operasional serta mempercepat transformasi digital bisnis Anda.",
    icon: "M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z",
    color: "text-violet-600",
    bg: "bg-violet-50",
    border: "border-violet-100",
  },
  {
    title: "AI & Machine Learning",
    desc: "Solusi cerdas berbasis data untuk otomatisasi proses bisnis dan analisis prediktif yang akurat.",
    icon: "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
    color: "text-purple-600",
    bg: "bg-purple-50",
    border: "border-purple-100",
  },
];
---

<section id="services" class="py-24 relative bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-slate-900">
        Layanan <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-violet-500"
          >Unggulan</span
        > Kami
      </h2>
      <p class="text-slate-500 max-w-2xl mx-auto text-lg">
        Pendekatan komprehensif kami memastikan setiap solusi teknologi sejalan
        dengan tujuan jangka panjang bisnis Anda.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        services.map((service) => (
          <div
            class={`bg-white border ${service.border} p-8 rounded-3xl card-hover group relative overflow-hidden shadow-sm hover:shadow-lg`}
          >
            <div class="absolute inset-0 bg-gradient-to-br from-indigo-50/50 to-violet-50/50 opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
            <div
              class={`w-14 h-14 rounded-2xl ${service.bg} border ${service.border} flex items-center justify-center mb-6 ${service.color}`}
            >
              <svg
                class="w-7 h-7"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d={service.icon}
                />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">
              {service.title}
            </h3>
            <p class="text-slate-500 text-sm leading-relaxed">{service.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
