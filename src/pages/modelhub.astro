---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const highlights = [
  {
    title: "Pusat Kendali Cerdas",
    desc: "Menjembatani karyawan, agen sistem, dan penyedia model AI dalam satu platform terpusat yang memverifikasi setiap permintaan secara real-time.",
    icon: "M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z",
    color: "text-[#4c42f7]",
    bg: "bg-[#4c42f7]/5",
    border: "border-[#4c42f7]/15",
  },
  {
    title: "Manajemen Izin Spesifik",
    desc: "Atur secara presisi dan granular siapa saja di dalam perusahaan Anda yang berhak mengakses dan menggunakan agen AI tertentu.",
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    color: "text-[#1a4689]",
    bg: "bg-[#1a4689]/5",
    border: "border-[#1a4689]/15",
  },
  {
    title: "Isolasi Data & Privasi Penuh",
    desc: "Seluruh basis data dan dokumen rahasia tetap terisolasi di dalam jaringan internal klien. Model Hub hanya mengatur akses tanpa pernah melihat atau menyentuh data privat.",
    icon: "M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z",
    color: "text-[#b14a4e]",
    bg: "bg-[#b14a4e]/5",
    border: "border-[#b14a4e]/15",
  },
  {
    title: "Ekosistem Mitra Tersertifikasi",
    desc: "Berkolaborasi dengan mitra pengembang tersertifikasi yang siap membangun agen AI khusus yang aman, terukur, dan sesuai kebutuhan bisnis Anda.",
    icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z",
    color: "text-[#f68c2c]",
    bg: "bg-[#f68c2c]/10",
    border: "border-[#f68c2c]/20",
  },
];
---

<Layout
  title="ModelHub | Produk Bara Digital Kreasi"
  description="Tingkatkan produktivitas dan keamanan bisnis Anda dengan Model Hub, platform terpusat yang menjembatani karyawan, agen sistem, dan penyedia model AI."
>
  <Navbar />

  <main class="pt-28 pb-24 bg-white min-h-screen overflow-hidden relative">
    <!-- Subtle background decoration -->
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
      <div
        class="absolute top-10 -right-40 w-[550px] h-[550px] bg-[#4c42f7]/[0.06] rounded-full blur-[90px]"
      >
      </div>
      <div
        class="absolute top-96 -left-40 w-[500px] h-[500px] bg-[#1a4689]/[0.06] rounded-full blur-[90px]"
      >
      </div>
    </div>

    <!-- Hero / Main Product Section -->
    <section class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <!-- Left Content: Logo & Narrative -->
        <div class="lg:col-span-7">
          <div
            class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white border border-slate-200 shadow-xs mb-8"
          >
            <img
              src="/modelhub-icon.png"
              alt="ModelHub Icon"
              class="w-5 h-5 object-contain"
            />
            <span class="text-sm font-semibold text-[#1a4689]"
              >Produk Unggulan Enterprise AI</span
            >
          </div>

          <div class="mb-8">
            <img
              src="/modelhub-logo.png"
              alt="ModelHub Logo"
              class="h-14 sm:h-16 md:h-20 w-auto object-contain"
            />
          </div>

          <div
            class="bg-white border border-slate-200/80 rounded-3xl p-6 sm:p-8 shadow-sm mb-8 relative overflow-hidden"
          >
            <div
              class="absolute top-0 left-0 w-1.5 h-full bg-gradient-to-b from-[#4c42f7] via-[#1a4689] to-[#f68c2c]"
            >
            </div>
            <p class="text-slate-700 text-lg md:text-xl leading-relaxed pl-3">
              Tingkatkan produktivitas dan keamanan bisnis Anda dengan <strong
                class="text-slate-900 font-semibold">Model Hub</strong
              >, sebuah platform terpusat yang menjembatani karyawan, agen
              sistem, dan penyedia model AI. Platform ini bertindak sebagai
              pusat kendali cerdas yang memverifikasi dan memberikan izin untuk
              setiap permintaan AI, sehingga perusahaan Anda dapat mengatur
              secara spesifik siapa saja yang berhak menggunakan agen tertentu.
              Privasi bisnis Anda terjamin karena seluruh basis data dan dokumen
              rahasia tetap terisolasi dengan aman di dalam jaringan internal
              klien, di mana Model Hub hanya mengatur akses tanpa pernah melihat
              atau menyentuh data privat tersebut. Melalui kolaborasi dengan
              mitra pengembang tersertifikasi yang siap membangun agen AI
              khusus, Model Hub menghadirkan ekosistem teknologi yang aman,
              terukur, dan memberi Anda kendali penuh atas inovasi di tempat
              kerja.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row items-center gap-4">
            <a
              href="/#contact"
              class="w-full sm:w-auto text-center px-8 py-4 rounded-full bg-gradient-to-r from-[#1a4689] via-[#d64a35] to-[#f68c2c] hover:opacity-95 text-white font-semibold shadow-lg shadow-[#1a4689]/20 transition-all duration-300 transform hover:-translate-y-0.5"
            >
              Jadwalkan Demo ModelHub
            </a>
            <a
              href="#fitur"
              class="w-full sm:w-auto text-center px-8 py-4 rounded-full border-2 border-slate-200 hover:border-[#4c42f7] text-slate-700 hover:text-[#4c42f7] font-semibold transition-all duration-300 bg-white"
            >
              Pelajari Cara Kerja
            </a>
          </div>
        </div>

        <!-- Right Visual Card: Brand Lockup & Architecture Illustration -->
        <div class="lg:col-span-5">
          <div class="relative">
            <div
              class="absolute -inset-1 bg-gradient-to-tr from-[#1a4689] via-[#4c42f7] to-[#f68c2c] rounded-3xl blur opacity-15"
            >
            </div>
            <div
              class="relative bg-white border border-slate-200/80 rounded-3xl p-8 shadow-sm flex flex-col items-center text-center"
            >
              <!-- Center Icon Badge -->
              <div
                class="w-28 h-28 rounded-3xl bg-white border border-slate-100 shadow-md p-3 flex items-center justify-center mb-6"
              >
                <img
                  src="/modelhub-icon.png"
                  alt="ModelHub Symbol"
                  class="w-full h-full object-contain"
                />
              </div>

              <img
                src="/modelhub-logo.png"
                alt="ModelHub"
                class="h-10 w-auto object-contain mb-3"
              />
              <p class="text-sm text-slate-500 mb-8">
                Enterprise AI Access & Governance Control Plane
              </p>

              <!-- Architecture Flow Diagram inside White Card -->
              <div class="w-full space-y-3 text-left">
                <div
                  class="flex items-center justify-between p-3.5 rounded-2xl bg-slate-50 border border-slate-100"
                >
                  <div class="flex items-center gap-3">
                    <span
                      class="w-2.5 h-2.5 rounded-full bg-[#1a4689] flex-shrink-0"
                    ></span>
                    <span class="text-sm font-semibold text-slate-800"
                      >Karyawan & Pengguna</span
                    >
                  </div>
                  <span
                    class="text-xs font-medium px-2.5 py-1 rounded-full bg-white border border-slate-200 text-slate-600"
                    >Verifikasi Izin</span
                  >
                </div>

                <div class="flex justify-center">
                  <svg
                    class="w-5 h-5 text-[#4c42f7]"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"
                    ></path>
                  </svg>
                </div>

                <div
                  class="flex items-center justify-between p-4 rounded-2xl bg-[#4c42f7]/5 border border-[#4c42f7]/20"
                >
                  <div class="flex items-center gap-3">
                    <img
                      src="/modelhub-icon.png"
                      alt="ModelHub"
                      class="w-6 h-6 object-contain"
                    />
                    <span class="text-sm font-bold text-slate-900"
                      >Model Hub Control Center</span
                    >
                  </div>
                  <span
                    class="text-xs font-semibold px-2.5 py-1 rounded-full bg-[#4c42f7] text-white"
                    >Zero Data Touch</span
                  >
                </div>

                <div class="flex justify-center">
                  <svg
                    class="w-5 h-5 text-[#f68c2c]"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"
                    ></path>
                  </svg>
                </div>

                <div class="grid grid-cols-2 gap-3">
                  <div
                    class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100"
                  >
                    <p class="text-xs font-bold text-[#1a4689] mb-1">
                      Jaringan Internal Klien
                    </p>
                    <p class="text-xs text-slate-500">
                      Basis data & dokumen rahasia terisolasi aman
                    </p>
                  </div>
                  <div
                    class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100"
                  >
                    <p class="text-xs font-bold text-[#f68c2c] mb-1">
                      Agen & Penyedia AI
                    </p>
                    <p class="text-xs text-slate-500">
                      Agen sistem & mitra pengembang tersertifikasi
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Key Pillars Section -->
    <section
      id="fitur"
      class="relative z-10 py-20 bg-white border-t border-slate-100"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold mb-4 text-slate-900">
            Keunggulan Utama <span
              class="text-transparent bg-clip-text bg-gradient-to-r from-[#1a4689] via-[#4c42f7] to-[#f68c2c]"
              >ModelHub</span
            >
          </h2>
          <p class="text-slate-500 max-w-2xl mx-auto text-lg">
            Kendali penuh atas inovasi AI di tempat kerja dengan standar
            keamanan dan privasi tingkat enterprise.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {
            highlights.map((item) => (
              <div
                class={`bg-white border ${item.border} p-7 rounded-3xl card-hover group relative overflow-hidden shadow-sm`}
              >
                <div
                  class={`w-14 h-14 rounded-2xl ${item.bg} border ${item.border} flex items-center justify-center mb-6 ${item.color}`}
                >
                  <svg
                    class="w-7 h-7"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"
                      d={item.icon}
                    />
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-3">
                  {item.title}
                </h3>
                <p class="text-slate-500 text-sm leading-relaxed">
                  {item.desc}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
